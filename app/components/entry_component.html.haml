- if @entry
  .entry-view.p-6.flex.flex-col.overflow-auto(style="height: 100vh; background: #faf8f5; font-family: 'DM Sans', sans-serif;")
    .entry-meta
      .flex.flex-row.items-center
        .bookmark-wrap
          = render BookmarkComponent.new(entry: @entry, bookmarked: @bookmarked)
        = link_to feed_path(@entry.feed), class: "entry-feed-link" do
          = @entry.feed.title
      %span.entry-date= @entry.published_at.to_fs(:long)

    = link_to @entry.link, target: "_blank", class: "entry-title-link" do
      %h1.entry-title= @entry.title

    - unless @entry.tags.count.zero?
      .entry-divider
      .flex.flex-row.flex-wrap.py-1
        - @entry.tags.each do |tag|
          = link_to tag_path(tag), class: "entry-tag" do
            = tag.name

    - if @entry.image
      = image_tag @entry.image, width: "1024", class: "entry-image"

    - if @entry.description
      .entry-divider
      .entry-description
        =raw @entry.description
