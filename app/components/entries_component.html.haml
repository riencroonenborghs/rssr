- height = mobile? ? "calc(100vh - 48px)" : "calc(100vh)"
.entries-list.flex.flex-col.overflow-auto(style="height: #{height}; background: #faf8f5; font-family: 'DM Sans', sans-serif;" data-controller="viewed_entries")
  - @entries.each do |entry|
    .entry-row
      .entry-row-meta
        .flex.flex-row.items-center(style="gap: 0.5rem")
          = render BookmarkComponent.new(entry: entry, bookmarked: !@bookmarks[entry.id].nil?)
          = link_to feed_path(entry.feed), class: "entry-row-feed" do
            = entry.feed.title
        %span.entry-row-date= entry.published_at.to_fs(:long)

      = link_to feed_entry_path(entry.feed, entry, page: params[:page]),
          target: mobile? ? "_blank" : "",
          class: "entry-row-title #{'viewed' if !@bookmarks_path && @viewed_entries[entry.id]}",
          data: { "turbo-frame": "entry", action: "click->viewed_entries#markAsViewed" } do
        = entry.title

      - if entry.image
        = image_tag entry.image, class: "entry-row-image"

      - if @tags_by_entry[entry.id]&.any?
        .flex.flex-row.flex-wrap(style="margin-top: 0.5rem")
          - @tags_by_entry[entry.id].each do |tag|
            = link_to tag_path(tag), class: "entry-row-tag" do
              = tag.name

  .entries-pagination
    = paginate @entries
