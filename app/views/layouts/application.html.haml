!!!
%html
  %head
    %title
      RSSReader
      = yield :meta_title 
    %meta(name="viewport" content="width=device-width, initial-scale=1")
    %meta(name="turbo-prefetch" content="false")
    = favicon_link_tag asset_path("favicon.png")
    %link(rel="apple-touch-icon" href="#{asset_path("apple-touch.png")}")
    = csrf_meta_tags
    = csp_meta_tag
    %link(rel="preconnect" href="https://fonts.googleapis.com")
    %link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin="")
    %link(href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet")
    = javascript_include_tag "application", type: "module"
    = stylesheet_link_tag "application"
    %link(href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@600&display=swap" rel="stylesheet")

  %body(class="c_#{controller_name} a_#{action_name} #{'signed-in' if current_user} #{'mobile' if mobile?}" data-controller="alerts")
    = turbo_frame_tag :meta_title

    - if mobile?
      .flex.flex-col.mobile(data-controller="menu")
        .flex.flex-row.justify-between.items-center.px-4.py-3(style="background: var(--sidebar-bg); border-bottom: 1px solid var(--border)")
          %a.logo-wordmark(href="/")
            RSSReader
          = link_to "#", data: { action: "click->menu#show" }, style: "color: var(--text-muted); font-size: 1.2rem; text-decoration: none;" do
            &#926;
        #menu.w-full.p-4.flex.flex-col.absolute.hidden(style="height: calc(100vh - 48px); top: 48px; background: var(--sidebar-bg); border-right: 1px solid var(--border)")
          .flex.flex-row.items-center.justify-between.mb-4
            %span(style="color: var(--text-muted); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase") Navigation
            = link_to "#", data: { action: "click->menu#hide" }, style: "color: var(--text-muted); text-decoration: none;" do
              &#8855;
          = link_to root_path, class: "nav-primary" do
            %span Unread
            %span.badge= unread_count
          - if user_signed_in?
            = link_to bookmarks_path, class: "nav-primary" do
              %span Bookmarks
              %span.badge= bookmarks_count
          .divider
          %div(data-controller="feeds-dropdown")
            %button.feeds-toggle(data-action="click->feeds-dropdown#toggle" type="button")
              %span Feeds
              %span.arrow(data-feeds-dropdown-target="arrow" style="transform: rotate(-90deg)") ▾
            .hidden.flex.flex-col.overflow-auto.sidebar-scroll.mt-1(data-feeds-dropdown-target="list" style="max-height: calc(100vh - 450px)")
              - active_feeds.each do |feed, count|
                = link_to feed_path(feed), class: "sidebar-link", data: { "turbo-frame": "entries" } do
                  %span= feed.title
                  %span.badge= count
          .divider
          %p.section-label Manage
          - if user_signed_in?
            = link_to subscriptions_path, class: "manage-link" do
              Subscriptions
            = link_to filters_path, class: "manage-link" do
              Filters
            = link_to "/sidekiq", class: "manage-link", target: "_blank" do
              Sidekiq
          - if user_signed_in?
            = link_to new_user_session_path, class: "manage-link", target: "_blank" do
              Sign Out
          - else
            = link_to new_user_session_path, class: "manage-link", target: "_blank" do
              Sign In
        = yield

    - else
      .flex.flex-row
        %aside(style="width: 232px; min-width: 232px; height: 100vh; background: var(--sidebar-bg); border-right: 1px solid var(--border); display: flex; flex-direction: column; justify-content: space-between;")
          %div
            .px-5.py-5(style="border-bottom: 1px solid var(--border)")
              %a.logo-wordmark(href="/")
                RSSReader
            .px-2.pt-4
              = link_to root_path, class: "nav-primary" do
                %span Unread
                %span.badge= unread_count
              - if user_signed_in?
                = link_to bookmarks_path, class: "nav-primary" do
                  %span Bookmarks
                  %span.badge= bookmarks_count
            .divider
            .px-2(data-controller="feeds-dropdown")
              %button.feeds-toggle(data-action="click->feeds-dropdown#toggle" type="button")
                %span Feeds
                %span.arrow(data-feeds-dropdown-target="arrow" style="transform: rotate(-90deg)") ▾
              .hidden.flex.flex-col.overflow-auto.sidebar-scroll.mt-1(data-feeds-dropdown-target="list" style="max-height: calc(100vh - 420px)")
                - active_feeds.each do |feed, count|
                  = link_to feed_path(feed), class: "sidebar-link", data: { "turbo-frame": "entries" } do
                    %span= feed.title
                    %span.badge= count
          %div.px-2.py-4(style="border-top: 1px solid var(--border)")
            %p.section-label.mb-2 Manage
            - if user_signed_in?
              = link_to subscriptions_path, class: "manage-link" do
                Subscriptions
              = link_to filters_path, class: "manage-link" do
                Filters
              = link_to "/sidekiq", class: "manage-link", target: "_blank" do
                Sidekiq
            .mt-3
              - if user_signed_in?
                = link_to new_user_session_path, class: "manage-link", target: "_blank" do
                  Sign Out
              - else
                = link_to new_user_session_path, class: "manage-link", target: "_blank" do
                  Sign In
        = yield
  = render "/layouts/flash"