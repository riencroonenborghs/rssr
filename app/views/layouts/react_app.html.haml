!!!
%html
  %head
    %title RSSReader
    %meta(name="viewport" content="width=device-width, initial-scale=1")
    = favicon_link_tag asset_path("favicon.png")
    = csrf_meta_tags
    = csp_meta_tag
    %link(rel="preconnect" href="https://fonts.googleapis.com")
    %link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin="")
    %link(href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet")
    = javascript_include_tag "react_app", type: "module"
    = stylesheet_link_tag "application"

  %body(style="margin: 0; padding: 0; background: var(--sidebar-bg); color: var(--text-primary);")
    #react-root(data-user-email="#{current_user&.email}")
